# Application
NEXT_PUBLIC_APP_NAME=FlowSet
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_ENV=development

# Public browser API (never put secrets in NEXT_PUBLIC_* variables)
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080/api/v1

# Optional server-side API URL used by Next.js SSR inside Docker
API_INTERNAL_BASE_URL=

# Feature flags
NEXT_PUBLIC_ENABLE_ANALYTICS=false
NEXT_PUBLIC_ENABLE_DARK_MODE=true

# Optional error tracking. Leave empty until a real project DSN exists.
NEXT_PUBLIC_SENTRY_DSN=

# --- Backend ---
APPLICATION_ENV=development
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:8080
SERVER_PORT=8080
LOG_LEVEL=INFO

DATABASE_URL=jdbc:postgresql://localhost:5432/flowset
DATABASE_USERNAME=flowset
DATABASE_PASSWORD=flowset

HIKARI_MAX_POOL_SIZE=10
HIKARI_MIN_IDLE=2
HIKARI_CONNECTION_TIMEOUT_MS=30000
HIKARI_IDLE_TIMEOUT_MS=600000
HIKARI_MAX_LIFETIME_MS=1800000

JWT_ACCESS_SECRET=dev-access-secret-must-be-at-least-32-characters
JWT_REFRESH_SECRET=dev-refresh-secret-must-be-at-least-32-characters
JWT_ACCESS_EXPIRATION_MS=900000
JWT_REFRESH_EXPIRATION_MS=604800000
JWT_REFRESH_COOKIE_NAME=flowset_refresh

CORS_ALLOWED_ORIGINS=http://localhost:3000
COOKIE_SECURE=false
COOKIE_SAME_SITE=Lax

STORAGE_PROVIDER=local
STORAGE_LOCAL_ROOT=./uploads
STORAGE_PUBLIC_BASE_URL=http://localhost:8080/api/v1/files

# Production storage (S3). Prefer an ECS task role over static keys.
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=
AWS_S3_ENDPOINT=
AWS_S3_SIGNED_URL_TTL_SECONDS=900

RATE_LIMIT_ENABLED=true
RATE_LIMIT_AUTH_PER_MINUTE=20
RATE_LIMIT_SEARCH_PER_MINUTE=60
RATE_LIMIT_SUPPORT_PER_MINUTE=10
RATE_LIMIT_ADMIN_PER_MINUTE=30

SPRINGDOC_ENABLED=true

# Demo catalog. Never enable in production.
DEMO_SEED_ENABLED=false
DEMO_SEED_PASSWORD=DemoPassw0rd!

# Redis is not used by the current MVP. Reserved if introduced later.
REDIS_URL=
